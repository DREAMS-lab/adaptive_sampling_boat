<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>boat_bringup</name>
  <version>1.0.0</version>
  <description>Launches, URDF, RViz config, and glue nodes (sonde adapter, ping safety, preflight) for the adaptive-sampling boat. Includes the sim-field publishers used by SITL.</description>
  <maintainer email="bharathvdesikan@gmail.com">blazair</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>mavros</depend>
  <depend>mavros_msgs</depend>
  <depend>info_gain</depend>
  <depend>nonstationary_planning</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
